# --- Database (MariaDB) ---
MARIADB_DATABASE=hardware_assistant
MARIADB_USER=app
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-root
DB_PORT=3306

# --- Backend ---
APP_PORT=8000

# --- Frontend ---
FRONTEND_PORT=4173

# --- Compatibility engine (psu_wattage_sufficient rule) ---
# required_watt = (cpu_tdp_w + gpu_tdp_w + PSU_BASE_WATT_W) * PSU_SAFETY_MARGIN
PSU_BASE_WATT_W=75
PSU_SAFETY_MARGIN=1.3

# --- Ollama (local LLM) ---
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Context window per Ollama call. Set explicitly because Ollama otherwise
# applies its own default and truncates silently on overflow -- an /extract
# prompt carrying a fetched page measures ~2800-3800 tokens. Lower this first
# if the host is short on memory (see backend/scripts/measure_prompt_budget.py).
OLLAMA_NUM_CTX=8192

# --- SearXNG (web lookup for /api/components/search + /extract) ---
SEARXNG_PORT=8080
# Any random string — the SearXNG image patches it into settings.yml on startup.
SEARXNG_SECRET=change-me-to-a-random-string
# Set to false to skip SearXNG entirely and let the LLM extract specs from its
# own knowledge instead (no code change needed, same pattern as BACKUP_BACKEND).
ENABLE_WEB_LOOKUP=true
# /extract also fetches and cleans the chosen search result's actual page
# (not just its short snippet) for extraction context. Set to false to go
# back to snippet-only behavior.
FETCH_FULL_PAGE=true

# --- Recommend pipeline ---
RECOMMEND_TOP_N=5
RECOMMEND_DEFAULT_MAX_BUILDS=3

# --- Backup ---
# Default backend when a backup request doesn't say which one to use: local | azure
# (the Backup tab/API can still pick a different one per call -- see README.md)
BACKUP_BACKEND=local

LOCAL_BACKUP_DIR=/app/backups

# Fill in EITHER one to make "azure" selectable as a backup destination at all,
# independently of whether BACKUP_BACKEND above is set to it
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_BACKUP_CONTAINER=inventory-backups

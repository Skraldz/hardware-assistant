# --- Database (MariaDB) ---
MARIADB_DATABASE=hardware_assistant
MARIADB_USER=app
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-root
DB_PORT=3306

# --- Backend ---
APP_PORT=8000

# --- Compatibility engine (psu_wattage_sufficient rule) ---
# required_watt = (cpu_tdp_w + gpu_tdp_w + PSU_BASE_WATT_W) * PSU_SAFETY_MARGIN
PSU_BASE_WATT_W=75
PSU_SAFETY_MARGIN=1.3

# --- Ollama (local LLM) ---
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- SearXNG (web lookup for /api/components/search + /extract) ---
SEARXNG_PORT=8080
# Any random string — the SearXNG image patches it into settings.yml on startup.
SEARXNG_SECRET=change-me-to-a-random-string
# Set to false to skip SearXNG entirely and let the LLM extract specs from its
# own knowledge instead (no code change needed, same pattern as BACKUP_BACKEND).
ENABLE_WEB_LOOKUP=true

# --- Recommend pipeline ---
RECOMMEND_TOP_N=5
RECOMMEND_DEFAULT_MAX_BUILDS=3

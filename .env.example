# --- Database (MariaDB) ---
MARIADB_DATABASE=hardware_assistant
MARIADB_USER=app
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-root
DB_PORT=3306

# --- Backend ---
APP_PORT=8000

# --- Compatibility engine (psu_wattage_sufficient rule) ---
# required_watt = (cpu_tdp_w + gpu_tdp_w + PSU_BASE_WATT_W) * PSU_SAFETY_MARGIN
PSU_BASE_WATT_W=75
PSU_SAFETY_MARGIN=1.3

# --- Ollama / SearXNG ---
# Reserved for later phases (LLM integration). Services already run in Compose,
# but the backend does not talk to them yet.
OLLAMA_PORT=11434
SEARXNG_PORT=8080
